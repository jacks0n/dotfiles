# vim: filetype=sh
# Note that /etc/paths will override $PATH after this file is executed.

export NONINTERACTIVE=1
export HOMEBREW_NO_ASK=1
export HOMEBREW_NO_REQUIRE_TAP_TRUST=1

if [ -x /opt/homebrew/bin/brew ] ; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ] ; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ] ; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# zsh ties fpath to FPATH, and `brew shellenv` exports FPATH - baking the
# version-pinned Cellar function path into the environment of every child
# process. When a brew upgrade replaces zsh, the old keg is deleted and any
# shell inheriting the stale FPATH can no longer autoload core functions
# (compinit, add-zsh-hook, is-at-least, colors). Repair: un-export FPATH so
# stale paths cannot propagate, dedupe, drop dead directories, and restore
# Homebrew's version-stable function dir. The zsh-only syntax is eval'd so
# bash can parse this file.
fpath_repair() {
  [ -n "$ZSH_VERSION" ] || return 0
  typeset +x FPATH
  eval 'typeset -gU fpath; fpath=( ${^fpath}(N-/) )'
  if [ -d "$HOMEBREW_PREFIX/share/zsh/functions" ] ; then
    fpath+=( "$HOMEBREW_PREFIX/share/zsh/functions" )
  fi
}
fpath_repair

##
# Base - required when `login` isn't used.
##

export PATH="/opt/X11/bin:$PATH"
export PATH="/sbin:$PATH"
export PATH="$HOMEBREW_PREFIX/bin:$PATH"

##
#  Global variables - $PATH, $MANPATH, $EDITOR, $VISUAL, etc.
##

export BACKUP_DIR="$HOME/Google Drive/Backup"

# Preferred editor for local and remote sessions.
export EDITOR='vim'
export VISUAL='vim'
if command -v nvim >/dev/null ; then
  export EDITOR='nvim'
  export VISUAL='nvim'
fi

if command -v bat >/dev/null ; then
  export MANPAGER='sh -c "col -bx | bat --language man --plain"'
  export PAGER='bat'
  export BAT_PAGER=''
  # Prevent delta (git diff) from using bat, which adds duplicate line numbers.
  export DELTA_PAGER='less'
fi

# Cross filesystem boundaries if the current directory isn't a Git repo.
export GIT_DISCOVERY_ACROSS_FILESYSTEM=1

# Homebrew no-GA.
export HOMEBREW_NO_ANALYTICS=1

# Neovide.
export NEOVIDE_FRAME='buttonless'
export NEOVIDE_MULTIGRID='true'

# Homebrew paths.
if hash brew 2>/dev/null ; then
  # Homebrew Cask path preferences.
  HOMEBREW_CASK_OPTIONS=(
    --fontdir=/Library/Fonts
    --colorpickerdir=/Library/ColorPickers
    --prefpanedir=/Library/PreferencePanes
    --qlplugindir=/Library/QuickLook
    --dictionarydir=/Library/Dictionaries
    --fontdir=/Library/Fonts
    --servicedir=/Library/Services
    --no-quarantine
  )
  export HOMEBREW_CASK_OPTS="$(IFS=' '; echo ${HOMEBREW_CASK_OPTIONS[@]})"

  # Homebrew GNU utilities (replaces BSD versions with GNU).
  gnu_homebrew_packages=(coreutils gnu-sed gnu-tar grep findutils gawk make)
  for gnu_homebrew_package in "${gnu_homebrew_packages[@]}" ; do
    export PATH="$HOMEBREW_PREFIX/opt/$gnu_homebrew_package/libexec/gnubin:$PATH"
    export MANPATH="$HOMEBREW_PREFIX/opt/$gnu_homebrew_package/libexec/gnuman:$MANPATH"
  done
  unset gnu_homebrew_package gnu_homebrew_packages

  # Curl.
  export PATH="$HOMEBREW_PREFIX/opt/curl/bin:$PATH"

  # Ruby.
  export PATH="$HOMEBREW_PREFIX/opt/ruby/bin:$PATH"

  # Java.
  export PATH="$HOMEBREW_PREFIX/opt/openjdk/bin:$PATH"

  # Rust. Homebrew deliberately does not link rustup's shims into its `bin` so
  # they cannot clash with the `rust` formula, so they must be added by hand.
  # These shims are what read a project's `rust-toolchain.toml` and dispatch to
  # the pinned toolchain; a direct `cargo` binary ahead of them on PATH silently
  # ignores those pins (~/Code/vendor/codex pins 1.95.0, amazon-q-developer-cli
  # pins 1.87.0).
  export PATH="$HOMEBREW_PREFIX/opt/rustup/bin:$PATH"
fi

# Dotfiles executables.
export PATH="$HOME/.dotfiles/bin:$PATH"

# Composer.
export PATH="$HOME/.composer/vendor/bin:$PATH"

# Docker.
export PATH="$HOME/.docker/bin:$PATH"

# Golang.
if hash go 2>/dev/null ; then
  export GOROOT="$HOMEBREW_PREFIX/opt/go/libexec"

  export GOPATH="$HOME/go"
  export PATH="$GOPATH/bin:$PATH"
  if [ ! -d "$GOPATH" ] ; then
    echo "=> Creating '$GOPATH': $GOPATH"
    mkdir "$GOPATH"
  fi
fi

# fzf - https://github.com/junegunn/fzf
# --inline-info: Display the result number besides the query.
export FZF_DEFAULT_OPTS="--inline-info --preview '(highlight -O ansi -l {} 2> /dev/null || cat {} || tree -C {}) 2> /dev/null | head -200'"
# Use `ag` as the default source for `fzf`.
if hash ag 2>/dev/null ; then
  export FZF_DEFAULT_COMMAND='ag -g ""'
fi
export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git"
export FZF_ALT_C_OPTS="--select-1 --exit-0 --scheme=path --preview 'tree -C {} | head -200'"

# Surpress Wine debugging info.
export WINEDEBUG=
export WINEPREFIX="$HOME/.wine"

export FUNCTIONS_CORE_TOOLS_TELEMETRY_OPTOUT='1'

# z - https://github.com/rupa/z
export _Z_NO_RESOLVE_SYMLINKS=1

# Python 3.
export PATH="$HOMEBREW_PREFIX/opt/python@3/bin:$PATH"
# export PATH="./.venv/bin:$PATH"

# Cargo packages.


# icu4c
export PATH="$HOMEBREW_PREFIX/opt/icu4c/bin:$PATH"
export PATH="$HOMEBREW_PREFIX/opt/icu4c/sbin:$PATH"

# Postgres.
export PATH="$HOMEBREW_PREFIX/opt/libpq/bin:$PATH"

# Bun.
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Orb.
export PATH="/Applications/OrbStack.app/Contents/MacOS/xbin:$PATH"
export PATH="/Applications/OrbStack.app/Contents/MacOS/bin:$PATH"

# Visual Studio Code.
export PATH="/Applications/Visual Studio Code.app/Contents/Resources/app/bin:$PATH"

# Local paths.
export PATH="./vendor/bin:$PATH"
export PATH="./node_modules/.bin:$PATH"
export PATH="bin:$PATH"

# Added by OrbStack: command-line tools and integration
source ~/.orbstack/shell/init.zsh 2>/dev/null || :
# Only present when Rust is installed via rustup-init (not Homebrew rustup).
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# uv.
export PATH="$HOME/.local/bin:$PATH"
