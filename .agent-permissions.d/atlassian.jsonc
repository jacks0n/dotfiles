{
  "version": 1,
  "permissions": {
    "allow": [
      // Confluence read-only
      "MCP(atlassian.atlassian-confluence_{check_content_permissions,download_*,get_*,list_*,search*})",
      "MCP(atlassian.confluence_{check_content_permissions,download_*,get_*,list_*,search*})",

      // Jira read-only
      "MCP(atlassian.atlassian-jira_{batch_get_changelogs,download_attachments,get_*,search*})",
      "MCP(atlassian.jira_{batch_get_changelogs,download_attachments,get_*,search*})"
    ]
  }
}
