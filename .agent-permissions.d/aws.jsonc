{
  "version": 1,
  "permissions": {
    "allow": [
      "Shell(aws acm {describe-*,list-*})",
      "Shell(aws apigateway get-*)",
      "Shell(aws ce get-*)",
      "Shell(aws cloudformation wait {stack-delete-complete,stack-rollback-complete})",
      "Shell(aws cloudformation {describe-*,get-*,list-*})",
      "Shell(aws cloudfront {get-*,list-*})",
      "Shell(aws cloudtrail {describe-*,get-*,lookup-*})",
      "Shell(aws cloudwatch {describe-*,get-*,list-*})",
      "Shell(aws codebuild batch-get-*)",
      "Shell(aws cognito-identity {describe-identity-pool,get-identity-pool-roles})",
      "Shell(aws cognito-idp {describe-*,list-*})",
      "Shell(aws configure {get,list*})",
      "Shell(aws dynamodb {describe-*,list-*})",
      "Shell(aws ec2 describe-*)",
      "Shell(aws ecs {describe-*,list-*})",
      "Shell(aws eks {describe-*,list-*})",
      "Shell(aws elasticache describe-*)",
      "Shell(aws elbv2 describe-*)",
      "Shell(aws events {describe-*,list-*})",
      "Shell(aws get-service-graph)",
      "Shell(aws iam {get-*,list-*,simulate-*})",
      "Shell(aws kms {describe-*,list-*})",
      "Shell(aws lambda {get-*,list-*})",
      "Shell(aws logs {describe-*,filter-*,get-*,start-query,tail})",
      "Shell(aws organizations {describe-*,list-*})",
      "Shell(aws rds {describe-*,list-*})",
      "Shell(aws resourcegroupstaggingapi get-*)",
      "Shell(aws route53 {get-*,list-*})",
      "Shell(aws route53resolver list-*)",
      "Shell(aws rum get-app-monitor)",
      "Shell(aws s3 ls)",
      "Shell(aws s3api {get-*,head-*,list-*})",
      "Shell(aws secretsmanager {describe-*,get-secret-value,list-*})",
      "Shell(aws ses {get-*,list-*})",
      "Shell(aws sesv2 get-*)",
      "Shell(aws sns {get-*,list-*})",
      "Shell(aws sqs {get-*,list-*})",
      "Shell(aws ssm {describe-*,get-*,list-*})",
      "Shell(aws sts get-*)",
      "Shell(aws synthetics {describe-*,get-*})",
      "Shell(aws values(--endpoint-url) lambda list-layers)",
      "Shell(aws xray {batch-get-*,get-*})"
    ]
  }
}
