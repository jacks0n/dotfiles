{
  "mcpServers": {
    "atlassian": { "enabled": false, "type": "streamable-http", "url": "http://127.0.0.1:9001/mcp" },
    "ddg-search": { "enabled": false, "type": "stdio", "command": "uvx", "args": ["duckduckgo-mcp-server"] },
    "coderift": {
      "enabled": false,
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "__HOME__/Code/vendor/coderift", "coderift-mcp", "--debug"]
    },
    "miro": { "enabled": false, "type": "streamable-http", "url": "https://mcp.miro.com" },
    "notion": { "enabled": false, "type": "streamable-http", "url": "https://mcp.notion.com/mcp" },
    "codex": { "enabled": false, "type": "stdio", "command": "codex", "args": ["mcp-server"] },
    "playwright": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": ["--yes", "--prefer-offline", "--fetch-retries=0", "--fetch-timeout=10000", "@playwright/mcp@latest", "--extension"]
    },
    "anytype": { "enabled": false, "type": "stdio", "command": "npx", "args": ["--yes", "--prefer-offline", "--fetch-retries=0", "--fetch-timeout=10000", "@anyproto/anytype-mcp@latest"] }
  },
  "users": [],
  "systemConfig": {
    "routing": { "enableGlobalRoute": true, "enableGroupNameRoute": true, "skipAuth": false, "enableBearerAuth": true },
    "oauthServer": {
      "enabled": true,
      "accessTokenLifetime": 3600,
      "refreshTokenLifetime": 1209600,
      "authorizationCodeLifetime": 300,
      "requireClientSecret": false,
      "allowedScopes": ["read", "write"],
      "requireState": false,
      "dynamicRegistration": { "enabled": true, "allowedGrantTypes": ["authorization_code", "refresh_token"], "requiresAuthentication": false }
    }
  },
  "bearerKeys": [],
  "prompts": [],
  "resources": []
}
